# Copy this file to ".env.local" and fill in your real values.
#
# Where to find these values:
#   1. Go to https://supabase.com and create a free project.
#   2. In the Supabase dashboard, click "Project Settings" → "API".
#   3. Copy the "Project URL" and "anon public" key into the lines below.
#
# Without these, the app runs in DEMO MODE (no real data persistence).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
